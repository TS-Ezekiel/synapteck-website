# Public site URL (metadata, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Database (Neon Postgres) ---
# Pooled string for the app, direct string for migrations (both from the Neon dashboard)
DATABASE_URL=
DIRECT_URL=

# --- Email (Resend) ---
RESEND_API_KEY=
# Where inquiry notifications go (comma-separate several)
CONTACT_TO_EMAIL=
# Must be on a domain verified in Resend. For testing leave as is.
CONTACT_FROM_EMAIL="Synapteck Website <onboarding@resend.dev>"

# --- Bot protection (Cloudflare Turnstile) ---
# Dev test keys that always pass:
#   site key  1x00000000000000000000AA
#   secret    1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Privacy ---
# Any long random string; used to hash visitor IPs before storing them
IP_HASH_SALT=change-me
